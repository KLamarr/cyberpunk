[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="doors"
3d_physics/layer_5="glass"
3d_physics/layer_6="props"
3d_physics/layer_7="interact"
3d_physics/layer_8="devices"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
