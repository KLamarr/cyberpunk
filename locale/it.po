#: scripts/actors/guard.gd:19
msgid "Huh? Someone there?"
msgstr "Eh? C'è qualcuno?"

#: scripts/actors/guard.gd:19
msgid "Who goes there?"
msgstr "Chi va là?"

#: scripts/actors/guard.gd:19
msgid "I saw something over there..."
msgstr "Ho visto qualcosa laggiù..."

#: scripts/actors/guard.gd:19
msgid "Hm? A shadow..."
msgstr "Hm? Un'ombra..."

#: scripts/actors/guard.gd:21
msgid "What was that noise?"
msgstr "Cos'era quel rumore?"

#: scripts/actors/guard.gd:21
msgid "Hm? Better check it out."
msgstr "Hm? Vado a controllare."

#: scripts/actors/guard.gd:21
msgid "I hear something..."
msgstr "Sento qualcosa..."

#: scripts/actors/guard.gd:21
msgid "Who's there?"
msgstr "Chi c'è?"

#: scripts/actors/guard.gd:23
msgid "Must be the CALMA making me hear things."
msgstr "Sarà stato il CALMA che mi fa sentire le cose."

#: scripts/actors/guard.gd:23
msgid "Nothing. Back to my rounds."
msgstr "Niente. Torno al giro."

#: scripts/actors/guard.gd:23
msgid "Must be imagining things."
msgstr "Mi sto immaginando tutto."

#: scripts/actors/guard.gd:23
msgid "Just rats. It's always rats."
msgstr "Topi. Sempre i topi."

#: scripts/actors/guard.gd:25
msgid "Intruder!"
msgstr "Intruso!"

#: scripts/actors/guard.gd:25
msgid "There you are! Freeze!"
msgstr "Eccoti! Fermo lì!"

#: scripts/actors/guard.gd:25
msgid "Contact! Level 14!"
msgstr "Contatto! Livello 14!"

#: scripts/actors/guard.gd:25
msgid "I see you!"
msgstr "Ti ho visto!"

#: scripts/actors/guard.gd:27
msgid "Where did they go?"
msgstr "Dov'è finito?"

#: scripts/actors/guard.gd:27
msgid "I know you're in here."
msgstr "So che sei qui dentro."

#: scripts/actors/guard.gd:27
msgid "Come on out. Don't make this worse for yourself."
msgstr "Esci fuori, non peggiorare le cose."

#: scripts/actors/guard.gd:27
msgid "Check the corners!"
msgstr "Controllate gli angoli!"

#: scripts/actors/guard.gd:29
msgid "Lost them. Staying alert."
msgstr "L'ho perso. Resto all'erta."

#: scripts/actors/guard.gd:29
msgid "Damn it, they're gone."
msgstr "Maledizione, è sparito."

#: scripts/actors/guard.gd:29
msgid "Back to my post. Eyes open."
msgstr "Torno in posizione, ma occhi aperti."

#: scripts/actors/guard.gd:31
msgid "Man down! Man down!"
msgstr "Uomo a terra! Uomo a terra!"

#: scripts/actors/guard.gd:31
msgid "Who did this to you?!"
msgstr "Chi ti ha fatto questo?!"

#: scripts/actors/guard.gd:31
msgid "Someone's in here!"
msgstr "C'è qualcuno qui dentro!"

#: scripts/actors/guard.gd:33
msgid "Alarm's up! On my way!"
msgstr "Allarme! Mi muovo!"

#: scripts/actors/guard.gd:33
msgid "Copy that, checking the sector."
msgstr "Ricevuto, controllo il settore."

#: scripts/actors/guard.gd:35
msgid "Argh! I'm hit!"
msgstr "Argh! Mi hanno colpito!"

#: scripts/actors/guard.gd:35
msgid "Ah! Bastard!"
msgstr "Ah! Maledetto!"

#: scripts/actors/guard.gd:37
#: assets/npc/characters/hale.tres:157
msgid "...you hear that hum too?"
msgstr "...lo senti anche tu, il ronzio?"

#: scripts/actors/guard.gd:37
#: assets/npc/characters/hale.tres:157
msgid "Six more hours to go."
msgstr "Altre sei ore di turno."

#: scripts/actors/guard.gd:37
msgid "The server's humming louder tonight."
msgstr "Il server ronza più forte stanotte."

#: scripts/actors/guard.gd:37
msgid "Wonder if Okafor's still in the lab."
msgstr "Chissà se Okafor è ancora in laboratorio."

#: scripts/actors/guard.gd:37
#: assets/npc/characters/hale.tres:157
msgid "My head hurts. Always after the update."
msgstr "Mi fa male la testa. Sempre dopo l'aggiornamento."

